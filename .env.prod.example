# 生产部署环境模板（G6/H3）——backend Settings 全量覆盖（字段与 backend/.env.example 对齐，
# 缺一个必填字段 startup_checks/pydantic 都会拒绝启动，beat 容器 2026-10-04 演练实测过）。
# 用法：cp .env.prod.example .env.prod，改掉全部密钥/口令后：
#   docker compose --env-file .env.prod -f docker-compose.prod.yml up -d --build
# 约束：DEBUG=false 触发 startup_checks 硬门禁——JWT/加密密钥 <32 字符、弱管理员密码、
# 通配 CORS、CSRF 未开启、Redis/Broker 缺失均启动即报错阻断（演练本身即验证门禁）。

# ---------- compose 插值（postgres 容器首启初始化用，改密码需进库改） ----------
POSTGRES_USER=loom
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=loom_db

# ---------- 前端发布端口（宿主侧） ----------
WEB_PORT=8080

# ---------- FastAPI 基础 ----------
APP_NAME=Loom API
APP_VERSION=0.1.0
# 生产必须 false：强制 CSRF Origin 校验、EPS 403、startup 硬门禁
DEBUG=false
HOST=0.0.0.0
PORT=8000

# ---------- 密钥（均须 ≥32 字符随机串：openssl rand -hex 32） ----------
JWT_SECRET_KEY=change-me-openssl-rand-hex-32
JWT_ALGORITHM=HS256
SECRET_ENCRYPTION_KEY=change-me-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------- 首启 bootstrap 种子管理员（弱口令会被 startup_checks 拒绝） ----------
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=change-me-strong-password
DEFAULT_ADMIN_NAME=系统管理员

# ---------- 数据库 / 缓存 / 队列（密码与上方保持一致；compose 会再显式覆盖一次） ----------
DATABASE_URL=postgresql+psycopg://loom:change-me-strong-password@postgres:5432/loom_db
REDIS_URL=redis://:change-me-redis-password@redis:6379/0
CELERY_BROKER_URL=redis://:change-me-redis-password@redis:6379/0
CELERY_RESULT_BACKEND=redis://:change-me-redis-password@redis:6379/0

# ---------- AI 适配（不用 AI 功能可留空 key，但字段须存在） ----------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# ---------- CORS / CSRF（显式列出前端访问来源，通配符会被 startup_checks 拒绝） ----------
# 来源须含「协议://主机:端口」完整形态，与用户实际访问地址一致
CORS_ORIGINS=["http://localhost:8080"]
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOW_HEADERS=Authorization,Content-Type,X-Requested-With,X-Device-Id,X-Request-Id,token,x-token
# DEBUG=false 时 validator 强制开启，此处显式 true 表达意图
ADMIN_CSRF_ORIGIN_CHECK_ENABLED=true
ADMIN_CAPTCHA_ENABLED=false

# ---------- 框架运行配置 ----------
RESPONSE_ENVELOPE_MAX_BYTES=2097152
MODULE_LOAD_STRICT=true
METRICS_ENABLED=false
API_VERSION_PREFIX_ENABLED=false
API_VERSION_PREFIX=/api/v1

# ---------- 密码与会话 ----------
PASSWORD_PBKDF2_ITERATIONS=210000
ADMIN_SESSION_MAX_CONCURRENT=0

# ---------- 文件存储 ----------
STORAGE_PROVIDER=local
MEDIA_REMOTE_DOWNLOAD_MAX_SIZE_MB=100
MEDIA_REMOTE_DOWNLOAD_TIMEOUT_SECONDS=30
MEDIA_REMOTE_ALLOWED_HOSTS=*.volces.com,*.toapis.cn,*.toapis.com,*.aliyuncs.com
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_REGION=auto
S3_PUBLIC_BASE_URL=

# ---------- 数据库连接池 ----------
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=true

# ---------- Redis 容器口令（compose 的 requirepass/healthcheck 用） ----------
REDIS_PASSWORD=change-me-redis-password
